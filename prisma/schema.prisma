generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Faq {
  id        String   @id @default(uuid())
  key       String   @unique
  question  String
  answer    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id            String    @id @default(uuid())
  name          String
  description   String?   @db.Text
  status        String    @default("Active")
  productsCount Int       @default(0)
  image         String?   @db.LongText
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]
}

model Product {
  id           String   @id @default(uuid())
  name         String
  categoryId   String
  price        Float
  stock        Int      @default(0)
  status       String   @default("Active")
  image        String?  @db.LongText
  gallery      Json?
  description  String?  @db.Text
  finishes     Json?
  sizes        Json?
  ringSizes    Json?
  tags         Json?
  isNew        Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isBestSeller  Boolean  @default(false)
  customBadge   String?
  weightInGrams Float    @default(0)
  pricingType   String   @default("weight_based")
  targetAudience String  @default("Women")
  mrpPrice      Float?
  rating        Float    @default(4.5)
  reviews       Int      @default(30)
  baseSilverRate Float?
  category      Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId], map: "Product_categoryId_fkey")
}

model Slide {
  id          Int      @id @default(autoincrement())
  title       String
  subtitle    String
  image       String   @db.LongText
  mobileImage String?  @db.LongText
  buttonText  String?
  link        String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  customerName  String
  email         String
  phone         String?
  address       String?     @db.Text
  city          String?
  state         String?
  pincode       String?
  totalAmount   Float
  discountAmount Float?     @default(0)
  couponCode    String?
  paymentMethod String      @default("cod")
  paymentStatus String      @default("Pending")
  orderStatus   String      @default("Processing")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  name      String
  price     Float
  quantity  Int
  size      String?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Coupon {
  id            String   @id @default(uuid())
  code          String   @unique
  discountType  String   // "percentage" or "flat"
  discountValue Float
  startDate     DateTime
  endDate       DateTime
  status        String   @default("Active") // Active, Inactive
  maxUses       Int?     // Optional limit on total uses
  currentUses   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
